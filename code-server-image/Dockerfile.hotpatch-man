# Hotpatch: enable man pages + UTF-8 locale on an already-built image.
# Usage:
#   docker build -f Dockerfile.hotpatch-man -t code-server-image .
FROM code-server-image

USER root

# bookworm-slim excludes man pages via dpkg path-exclude; drop that so man works.
RUN sed -i '/^path-exclude \/usr\/share\/man/d' /etc/dpkg/dpkg.cfg.d/docker \
 && apt-get -o Acquire::Check-Valid-Until=false -o Acquire::Check-Date=false update \
 && apt-get install -y --no-install-recommends -o APT::Keep-Downloaded-Packages=false \
    groff-base \
    less \
    man-db \
    manpages \
    manpages-dev \
 && apt-get install -y --reinstall --no-install-recommends -o APT::Keep-Downloaded-Packages=false \
    bash \
    coreutils \
    debianutils \
    findutils \
    grep \
    gzip \
    sed \
    tar \
    util-linux \
    valgrind \
    vim \
    python3 \
 && apt-get clean \
 && rm -rf /var/lib/apt/lists/* /var/cache/apt/archives/* /tmp/*

ENV LANG=C.UTF-8 \
    LC_ALL=C.UTF-8

USER coder
